# Prawnstars MTG on this PC. Caddy serves the built app (dist/) on
# 127.0.0.1:8080 and forwards /relay to the relay on 127.0.0.1:9443. A
# Cloudflare Tunnel publishes this one local address over HTTPS, so nothing on
# this PC is opened to the internet directly. Started by start-prawnstars.ps1.
{
	admin off
	auto_https off
}

http://:8080 {
	bind 127.0.0.1
	root * {$PRAWNSTARS_DIST}
	encode zstd gzip

	# The relay's websocket, on the same link as the app.
	handle_path /relay* {
		reverse_proxy 127.0.0.1:9443
	}

	# Runtime config (works out the relay address from the page's own link).
	@config path /config.js
	handle @config {
		header Cache-Control "no-store"
		file_server
	}

	handle {
		# Cross-origin isolation, which the in-browser engine needs.
		header {
			Cross-Origin-Opener-Policy "same-origin"
			Cross-Origin-Embedder-Policy "require-corp"
			Cross-Origin-Resource-Policy "same-origin"
		}
		try_files {path} /index.html
		file_server
	}
}
